{
  "name": "@openchamber/opencode-cursor",
  "version": "2.5.1",
  "description": "Cursor models in OpenCode via the official Cursor SDK — SDK-owned auth, live models, streaming, OpenCode-owned tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/**/*.test.mjs",
    "test:compliance": "node scripts/verify-no-private-cursor-api.mjs",
    "prepublishOnly": "npm run build && npm run test && npm run test:compliance"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openchamber/opencode-cursor.git"
  },
  "homepage": "https://github.com/openchamber/opencode-cursor",
  "bugs": {
    "url": "https://github.com/openchamber/opencode-cursor/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "cursor-sdk",
    "openai-compatible",
    "ai",
    "llm",
    "streaming",
    "agent"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
